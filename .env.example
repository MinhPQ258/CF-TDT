# Đặt trên Vercel theo từng môi trường. KHÔNG commit giá trị thật.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Chỉ server: dùng cho auth.admin (tạo tài khoản, đặt lại mật khẩu, khóa phiên) và cron đối soát
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
CRON_SECRET=<chuỗi ngẫu nhiên dài>
APP_AUTH_EMAIL_DOMAIN=coffee.internal
